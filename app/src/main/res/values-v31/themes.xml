        <item name="android:windowBackground">#15130B</item>
        <item name="android:statusBarColor">#15130B</item>
        <item name="android:navigationBarColor">#15130B</item>
        <item name="android:windowSplashScreenBackground">#FF15130B</item>
    </style>
</resources>
