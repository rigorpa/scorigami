        <item name="android:windowBackground">#002451</item>
        <item name="android:statusBarColor">#002451</item>
        <item name="android:navigationBarColor">#002451</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
    </style>
</resources>
